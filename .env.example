# Copy this file to .env and fill in the values. The .env file is gitignored.

# Burner wallet private key used to pay for specialist calls over x402.
# Use a throwaway key funded with testnet USDC only. Never use a key that holds real funds.
EVM_PRIVATE_KEY=0xyour_burner_key_here

# Optional. Only needed to run the frontier baseline control (src/route.mjs --baseline),
# which calls the Anjoman agent API with specialists turned off.
ANJOMAN_API_KEY=
